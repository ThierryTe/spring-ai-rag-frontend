server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy vers le backend Spring Boot : garde les appels Angular en chemin
    # relatif (/api, voir core/config/api.config.ts) inchange entre dev (proxy Angular
    # CLI) et prod (ce proxy nginx) - seule la cible BACKEND_HOST change.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fallback SPA : toute route Angular (ex. /workspace) doit servir index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
